# Copy to backend/.env and fill in. NEVER commit .env.
# Neon OWNER connection string — used only by db:setup / db:seed / provision.
DATABASE_URL=
# Long random string for signing JWTs (stored in Secrets Manager by `npm run provision`)
JWT_SECRET=
# Calendarific API key (stored in Secrets Manager by `npm run provision`)
CALENDARIFIC_API_KEY=
# Per-service DB role passwords (generated by `npm run db:setup`)
DB_PASSWORD_AUTH=
DB_PASSWORD_HALLS=
DB_PASSWORD_EXAMS=
DB_PASSWORD_ALLOCATION=
# Demo account passwords (generated by `npm run db:seed`)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_STUDENT_PASSWORD=
# Optional
# CORS_ORIGINS=http://localhost:4566,http://127.0.0.1:4566
