{
  "name": "exam-seating-planner-backend",
  "version": "1.0.0",
  "description": "Exam Seating Planner: microservices on Floci (local AWS) + Neon Postgres",
  "scripts": {
    "dev": "node scripts/dev.js",
    "db:setup": "node db/setup.js",
    "db:reset": "node db/setup.js --reset && node db/seed.js",
    "db:seed": "node db/seed.js",
    "provision": "node infra/provision.js",
    "deploy:web": "node infra/deploy-frontend.js",
    "floci:up": "docker compose -f ../infra/floci/docker-compose.yml up -d",
    "test:exams": "node tests/exams.api.test.js",
    "test:alloc": "node tests/allocation.api.test.js",
    "test:halls": "node tests/halls.api.test.js",
    "test:halls:isolated": "npm --prefix tests/isolated install --no-audit --no-fund --silent && node tests/isolated/halls.js",
    "test:auth:isolated": "npm --prefix tests/isolated install --no-audit --no-fund --silent && node tests/isolated/auth.js",
    "evidence:monitoring": "node tests/monitoring.evidence.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1178.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1175.0",
    "@aws-sdk/client-dynamodb": "^3.1178.0",
    "@aws-sdk/client-ec2": "^3.1178.0",
    "@aws-sdk/client-ecs": "^3.1178.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1178.0",
    "@aws-sdk/client-eventbridge": "^3.1178.0",
    "@aws-sdk/client-iam": "^3.1178.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-secrets-manager": "^3.1178.0",
    "@aws-sdk/client-sns": "^3.1178.0",
    "@aws-sdk/client-sqs": "^3.1175.0",
    "@aws-sdk/lib-dynamodb": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@neondatabase/serverless": "^1.2.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
